# .env.example

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=socialautomation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-key-minimum-32-characters-long-change-me
JWT_ISSUER=SocialAutomation
JWT_AUDIENCE=SocialAutomation
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=30

# Instagram / Meta (Fase 2)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# AI (Fase 5)
AI_PROVIDER=openai
AI_API_KEY=

# Storage (Fase 7)
STORAGE_PROVIDER=local
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_ENDPOINT=

# Application
APP_URL=http://localhost:8010
API_URL=http://localhost:5010
ASPNETCORE_ENVIRONMENT=Development